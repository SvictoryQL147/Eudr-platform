# Copy to .env and edit. Same host/port/user/password you use in pgAdmin.
EUDR_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/eudr_core

# REQUIRED before deploying: any long random string (40+ characters).
EUDR_JWT_SECRET=change-me-to-a-long-random-string

# Where the web dashboard runs (comma-separated if several).
EUDR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploaded certificates/IDs are saved here.
EUDR_STORAGE_DIR=storage

EUDR_OCR_BACKEND=mock

# Deforestation screening: whisp | demo | none
#   whisp = real results from the FAO / Forest Data Partnership Whisp API
#           (sign in at whisp.openforis.org, create an API key on your account page)
#   demo  = fake results for demos only, labelled DEMO everywhere
EUDR_SCREENING_PROVIDER=none
EUDR_WHISP_API_KEY=

# --- Ala Trace (Phase 1) -------------------------------------------------
# Public address of the web app; links in emails point here.
EUDR_APP_URL=http://localhost:3000
EUDR_ENVIRONMENT=development

# Email for password resets and invitations: console | resend
#   console = printed in this terminal (fine on your computer)
#   resend  = real emails via resend.com (free tier). Verify your domain there
#             and set EUDR_EMAIL_FROM to an address on it.
EUDR_EMAIL_BACKEND=console
EUDR_RESEND_API_KEY=
EUDR_EMAIL_FROM=Ala Trace <onboarding@resend.dev>

# Document storage: local | s3
#   s3 = Cloudflare R2 (recommended), AWS S3 or any S3-compatible bucket.
#        Required on Vercel. For R2: endpoint https://<account_id>.r2.cloudflarestorage.com, region auto.
EUDR_STORAGE_BACKEND=local
EUDR_S3_BUCKET=
EUDR_S3_ENDPOINT_URL=
EUDR_S3_REGION=auto
EUDR_S3_ACCESS_KEY_ID=
EUDR_S3_SECRET_ACCESS_KEY=

# Error monitoring (optional): paste the DSN from sentry.io.
EUDR_SENTRY_DSN=
