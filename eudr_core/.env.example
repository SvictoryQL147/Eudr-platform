# Copy to .env and edit. Same host/port/user/password you use in pgAdmin.
EUDR_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/eudr_core

# REQUIRED before deploying: any long random string (40+ characters).
EUDR_JWT_SECRET=change-me-to-a-long-random-string

# Where the web dashboard runs (comma-separated if several).
EUDR_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Uploaded certificates/IDs are saved here.
EUDR_STORAGE_DIR=storage

EUDR_OCR_BACKEND=mock

# Deforestation screening: whisp | demo | none
#   whisp = real results from the FAO / Forest Data Partnership Whisp API
#           (sign in at whisp.openforis.org, create an API key on your account page)
#   demo  = fake results for demos only, labelled DEMO everywhere
EUDR_SCREENING_PROVIDER=none
EUDR_WHISP_API_KEY=
