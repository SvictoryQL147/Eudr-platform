# Copy to .env.local (optional). Leave NEXT_PUBLIC_API_URL unset: the app
# talks to the backend on its own address (sessions use a same-site cookie).
NEXT_PUBLIC_APP_NAME=Ala Trace
# NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain
# Only if the backend isn't on 127.0.0.1:8000 during development:
# API_PROXY_URL=http://127.0.0.1:8000
