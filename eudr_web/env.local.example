# Where the FastAPI backend (eudr_core) is running. Leave unset on Vercel.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Product name shown in the dashboard and landing page
NEXT_PUBLIC_APP_NAME=EUDR Ready
# Optional: email that "Get a free readiness check" opens. Unset = sends people to sign-up.
# NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
